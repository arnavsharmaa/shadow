# ---------------------------------------------------------------------------
# Shadow — local configuration
# Copy this file to `.env` and adjust as needed. Nothing here is a secret.
# ---------------------------------------------------------------------------

# Database.
#   - Leave unset to use the embedded PGlite database stored in ./.shadow/data
#     (zero infrastructure, ideal for local development and the demo).
#   - Point at PostgreSQL for a server deployment or `docker compose up`:
#       DATABASE_URL=postgres://shadow:shadow@localhost:5432/shadow
DATABASE_URL=

# API server.
SHADOW_API_HOST=127.0.0.1
SHADOW_API_PORT=4000
SHADOW_LOG_LEVEL=info

# Run migrations at API startup (recommended for local development).
SHADOW_AUTO_MIGRATE=true
# Seed the deterministic demo data when the database is empty.
SHADOW_AUTO_SEED=true

# Maximum accepted request body (bytes). Applies to ingestion and import.
SHADOW_MAX_BODY_BYTES=10485760

# Extra secret-redaction patterns (comma separated regular expressions applied to
# JSON keys). The defaults already cover password, api_key, authorization,
# secret, token and cookie.
SHADOW_REDACT_PATTERNS=

# Optional: comma-separated ES modules (paths relative to the repository root)
# whose exports are AgentDefinitions. Loaded at API startup so the agents they
# describe can be forked and replayed. See docs/concepts/replay-modes.md.
SHADOW_REPLAY_MODULES=

# Optional bearer token. When set, every /api/* request must send
# `Authorization: Bearer <token>`; /health and /docs stay open. Give the same
# value to the SDK (`token` option or SHADOW_TOKEN), the CLI (--token or
# SHADOW_TOKEN) and the web app (NEXT_PUBLIC_SHADOW_API_TOKEN).
SHADOW_API_TOKEN=

# Project slug for traces ingested through the OpenTelemetry endpoint
# (POST /api/v1/otlp/v1/traces) when their resource has no service.namespace.
SHADOW_OTLP_DEFAULT_PROJECT=otel

# Optional retention: delete traces that started more than this many days ago.
# Leave empty to keep everything. The sweep runs at startup and then every
# SHADOW_RETENTION_INTERVAL_MINUTES (default 60), in bounded batches.
SHADOW_RETENTION_DAYS=
SHADOW_RETENTION_INTERVAL_MINUTES=60

# Comma-separated list of allowed CORS origins for the API.
SHADOW_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web application: where the browser should find the API.
NEXT_PUBLIC_SHADOW_API_URL=http://localhost:4000
# Must match SHADOW_API_TOKEN when one is set (embedded in the browser bundle).
NEXT_PUBLIC_SHADOW_API_TOKEN=
