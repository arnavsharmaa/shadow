{
  "name": "@shadow/web",
  "version": "0.1.0",
  "private": true,
  "description": "Shadow web application: trace explorer, trace detail, fork editor and branch comparison.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnavsharmaa/shadow.git",
    "directory": "apps/web"
