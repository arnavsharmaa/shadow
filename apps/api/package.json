{
  "name": "@shadow/api",
  "version": "0.1.0",
  "private": true,
  "description": "Shadow API service: ingestion, persistence, replay orchestration and comparisons.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnavsharmaa/shadow.git",
    "directory": "apps/api"
  },
  "homepage": "https://github.com/arnavsharmaa/shadow#readme",
  "bugs": {
    "url": "https://github.com/arnavsharmaa/shadow/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cors": "11.3.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "5.2.6",
    "@shadow/core": "workspace:*",
    "@shadow/schemas": "workspace:*",
    "@shadow/testkit": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.3",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.0",
    "pino": "9.14.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@shadow/config": "workspace:*",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "3.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "pino-pretty": "13.1.3",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
