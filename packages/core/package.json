{
  "name": "@shadow/core",
  "version": "0.1.0",
  "description": "Shadow core engine: event ordering, state reconstruction, forks, deterministic replay and branch comparison.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnavsharmaa/shadow.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/arnavsharmaa/shadow#readme",
  "bugs": {
    "url": "https://github.com/arnavsharmaa/shadow/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "bench": "tsx bench/large-trace.bench.ts",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@shadow/schemas": "workspace:*"
  },
  "devDependencies": {
    "@shadow/config": "workspace:*",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "keywords": [
    "ai-agents",
    "debugging",
    "tracing",
    "replay",
    "observability",
    "llm"
  ]
}
