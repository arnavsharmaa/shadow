{
  "name": "@shadow/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Shadow: list, inspect, export, import and replay traces.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arnavsharmaa/shadow.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/arnavsharmaa/shadow#readme",
  "bugs": {
    "url": "https://github.com/arnavsharmaa/shadow/issues"
  },
  "type": "module",
  "bin": {
    "shadow": "./bin/shadow.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@shadow/core": "workspace:*",
    "@shadow/schemas": "workspace:*",
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@shadow/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "keywords": [
    "ai-agents",
    "debugging",
    "tracing",
    "replay",
    "observability",
    "llm"
  ]
}
